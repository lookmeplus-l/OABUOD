<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oabuod_bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/home_welcome"
        android:textColor="@color/oabuod_text_main"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_subtitle"
        android:textColor="@color/oabuod_text_sub"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/home_login_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_login_status_unknown"
            android:textColor="@color/oabuod_text_sub"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_go_login"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="@string/home_not_logged_in"
            android:textColor="@color/oabuod_primary"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能"
            android:textColor="@color/oabuod_text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/card_chat"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/oabuod_bg_light"
                android:text="@string/nav_chat"
                android:textColor="@color/oabuod_text_main"
                android:textSize="16sp" />

            <Button
                android:id="@+id/card_image"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/oabuod_bg_light"
                android:text="@string/nav_image"
                android:textColor="@color/oabuod_text_main"
                android:textSize="16sp" />

            <Button
                android:id="@+id/card_video"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/oabuod_bg_light"
                android:text="@string/nav_video"
                android:textColor="@color/oabuod_text_main"
                android:textSize="16sp" />

            <Button
                android:id="@+id/card_office"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/oabuod_bg_light"
                android:text="@string/nav_office"
                android:textColor="@color/oabuod_text_main"
                android:textSize="16sp" />
        </GridLayout>
    </LinearLayout>

</LinearLayout>
