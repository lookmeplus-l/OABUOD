<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oabuod_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_office"
        android:textColor="@color/oabuod_text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/office_doc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/oabuod_bg_light"
            android:text="@string/office_doc"
            android:textColor="@color/oabuod_text_main"
            android:textSize="13sp" />

        <Button
            android:id="@+id/office_table"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="@color/oabuod_bg_light"
            android:text="@string/office_table"
            android:textColor="@color/oabuod_text_main"
            android:textSize="13sp" />

        <Button
            android:id="@+id/office_slide"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="@color/oabuod_bg_light"
            android:text="@string/office_slide"
            android:textColor="@color/oabuod_text_main"
            android:textSize="13sp" />

        <Button
            android:id="@+id/office_mind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/oabuod_bg_light"
            android:text="@string/office_mind"
            android:textColor="@color/oabuod_text_main"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/task_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="@string/task_prompt_hint"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:minHeight="56dp"
        android:padding="12dp"
        android:textColor="@color/oabuod_text_main"
        android:textColorHint="@color/oabuod_text_sub"
        android:textSize="15sp" />

    <Button
        android:id="@+id/task_generate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/oabuod_primary"
        android:text="@string/task_generate"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/task_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/task_no_result"
        android:textColor="@color/oabuod_text_sub"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/task_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
